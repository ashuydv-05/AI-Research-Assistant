# arXiv Research Assistant Environment Variables

# === Required ===
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_2=openai/gpt-oss-20b

# === Evaluation Judge (Optional - Google Gemini Flash) ===
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# === Retrieval Infrastructure (Required for Hybrid RAG) ===
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=arxiv_papers
ES_URL=https://your-elasticsearch-cloud-endpoint
ES_API_KEY=your_elasticsearch_api_key_here
ES_INDEX=arxiv_papers
ES_REQUEST_TIMEOUT=10

# Existing vectors use this exact model and dimension.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
DENSE_VECTOR_NAME=dense

# === LLM Settings (Optional) ===
# GROQ_MAX_TOKENS=8192
GROQ_TEMPERATURE=0.7

# === Retrieval Settings (Optional) ===
# Cross-encoder rerank is off by default: loading it on Render free RAM kills paper queries.
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=5
RERANKER_CANDIDATE_K=10
RRF_K=60
RETRIEVAL_PREFETCH_K=50
RETRIEVAL_FINAL_K=20
MAX_PDF_UPLOAD_MB=50

# === Web Search (Optional) ===
TAVILY_API_KEY=your_tavily_api_key_here

# === Observability (Optional) ===
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# === Frontend (Optional) ===
ALLOWED_ORIGINS=http://localhost:3000
DEBUG=false
